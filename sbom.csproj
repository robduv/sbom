<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sbom-cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BLite" Version="5.2.1" />
    <PackageReference Include="CycloneDX.Core" Version="12.1.2" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Spdx3" Version="1.0.4" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="examples/**/*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
